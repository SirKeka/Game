# фаил материала

version=2
# Типы могут быть phong, pbr, custom.
type=pbr
name=polySurface1SG1
# Если тип custom, требуется шейдер.
shader=Shader.PBRMaterial

[map]
name=albedo
filter_min=linear
filter_mag=linear
repeat_u=repeat
repeat_v=repeat
repeat_w=repeat
texture_name=DB2X2_L01
[/map]

[map]
name=(null)
filter_min=linear
filter_mag=linear
repeat_u=repeat
repeat_v=repeat
repeat_w=repeat
texture_name=DB2X2_L01_Spec
[/map]

[prop]
name=diffuse_colour
type=vec4
value=0.000000 0.000000 0.000000 0.000000
[/prop]

[prop]
name=diffuse_colour
type=vec4
value=0.000000 0.000000 0.000000 0.000000
[/prop]

[prop]
name=specular
type=f32
value=5.890000
[/prop]
