# Конфигурационный фаил шейдера
version=1
name=Shader.StandardUI
cull_mode=none
renderpass=Renderpass.Builtin.UI
stages=vertex,fragment
stagefiles=shaders/StandardUIShader.vert.glsl,shaders/StandardUIShader.frag.glsl
depth_test=0
depth_write=0
stencil_test=1
stencil_write=1
max_instances=512

# Атрибуты: тип, имя
attribute=vec2,in_position
attribute=vec2,in_texcoord

# Униформы: тип, область видимости, имя
# ПРИМЕЧАНИЕ: Для области видимости: 0 = глобальная, 1 = экземпляр, 2 = локальная
uniform=mat4,0,projection
uniform=mat4,0,view
uniform=struct16,1,properties
uniform=sampler2D,1,diffuse_texture
uniform=mat4,2,model
