# Фаил настроек ландшафта "Moon"
version=1
name=test_terrain

# Если установлено, изображение используется в качестве данных карты высот.
heightmap_file=terrain_heightmap_256

# Если значение не указано, по умолчанию используется значение 16.
chunk_size=16

scale_x=2.0
scale_y=20.0
scale_z=2.0

material0=river_rock1
material1=wavy-sand
material2=wispy-grass-meadow
material3=Crusted_snow2
